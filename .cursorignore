# VCS
.git/
.github/
.gitlab/

# Project-specific items not in .gitignore
document/**/*.drawio
**/documents/

# KHÔNG ignore file .env* để Cursor AI có thể track
# (Git vẫn ignore chúng qua .gitignore)
# Explicitly include .env files for Cursor AI
!**/.env
!**/.env.local
!**/.env.*.local
!**/.env.example