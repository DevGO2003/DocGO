# DocGO Environment Variables Template
# Copy this file to .env and fill in your actual values

# MongoDB Configuration
MDB_MCP_CONNECTION_STRING=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MDB_MCP_READ_ONLY=false
MDB_MCP_TRANSPORT=stdio
MDB_MCP_LOGGERS=mcp,stderr

# Google Cloud Configuration  
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/service-account-key.json
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com

# OAuth2 Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8001/login/oauth2/code/google
GOOGLE_CLIENT_EMAIL=your-email@gmail.com
GOOGLE_PROJECT_ID=your-project-id

# PostgreSQL Configuration
POSTGRES_DB=docgo_db
POSTGRES_USER=docgo_user
POSTGRES_PASSWORD=your-secure-password

# GitHub MCP Configuration
GITHUB_TOKEN=your-github-token
GITHUB_OWNER=your-username
GITHUB_REPO=your-repo

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Configuration
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=docgo-client
KAFKA_GROUP_ID=docgo-group
