# ==========================================
# DOCGO ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# ==========================================
# DATABASE CONFIGURATION (REPLACE WITH YOUR VALUES)
# ==========================================
MONGODB_ATLAS_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_USER_DATABASE=docgo_user_service
MONGODB_DOCUMENT_DATABASE=docgo_document_service
MONGODB_AUTOMATION_DATABASE=docgo_automation_service

# ==========================================
# SECURITY CONFIGURATION (REPLACE WITH YOUR VALUES)
# ==========================================
JWT_SECRET=your-super-secret-jwt-key-here-change-this-in-production
JWT_EXPIRES_IN=24h

# ==========================================
# AI/ML CONFIGURATION (REPLACE WITH YOUR VALUES)
# ==========================================
GEMINI_API_KEY=your-gemini-api-key-here

# ==========================================
# KAFKA CONFIGURATION
# ==========================================
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID_PREFIX=docgo
KAFKA_GROUP_ID_PREFIX=docgo-group

# ==========================================
# REDIS CONFIGURATION
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379

# ==========================================
# API GATEWAY CONFIGURATION
# ==========================================
API_GATEWAY_PORT=8000
USER_MANAGEMENT_SERVICE_URL=http://user-management-service:8000
DOCUMENT_MANAGEMENT_SERVICE_URL=http://document-management-service:8000
AUTOMATION_SERVICE_URL=http://automation-service:8000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info
CORS_ORIGIN=*

# ==========================================
# SERVICE PORTS
# ==========================================
USER_MANAGEMENT_PORT=8001
DOCUMENT_MANAGEMENT_PORT=8002
AUTOMATION_PORT=8003
WEB_APP_PORT=3000

# ==========================================
# FILE STORAGE CONFIGURATION
# ==========================================
FILE_STORAGE_PATH=/app/uploads
RESULTS_PATH=/app/results
MAX_FILE_SIZE=10MB

# ==========================================
# INFRASTRUCTURE PORTS
# ==========================================
KAFKA_PORT=9092
REDIS_PORT=6379
KAFKA_UI_PORT=8080
ZOOKEEPER_PORT=2181
