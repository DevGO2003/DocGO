# Contract Management Service - Development Environment

# Spring Boot Configuration
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8000

# MongoDB Atlas Configuration
SPRING_DATA_MONGODB_URI=mongodb+srv://root:sapassword@devgo-docgo-cluster0.hsudzga.mongodb.net/docgo_contract_service?retryWrites=true&w=majority&appName=devgo-docgo-cluster0

# Database Configuration (MySQL - fallback)
