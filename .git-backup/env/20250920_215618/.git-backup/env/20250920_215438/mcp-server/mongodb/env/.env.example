# MongoDB MCP Server Environment Variables

# MongoDB Configuration
MDB_MCP_CONNECTION_STRING=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MDB_MCP_READ_ONLY=false
MDB_MCP_TRANSPORT=stdio
MDB_MCP_LOGGERS=mcp,stderr

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
