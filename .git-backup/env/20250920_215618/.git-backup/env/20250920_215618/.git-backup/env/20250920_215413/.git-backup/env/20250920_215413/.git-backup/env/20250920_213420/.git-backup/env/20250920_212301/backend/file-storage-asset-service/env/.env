# File Storage Asset Service - Development Environment

# Service Runtime Configuration
ENVIRONMENT=development

# MongoDB Atlas Configuration
MONGODB_ATLAS_URI=mongodb+srv://root:sapassword@devgo-docgo-cluster0.hsudzga.mongodb.net/docgo_file_service?retryWrites=true&w=majority&appName=devgo-docgo-cluster0

# Database Configuration (MySQL - fallback)
DATABASE_URL=mysql+pymysql://root:sapassword@localhost:3306/docgo_file_storage
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=docgo_file_storage
DATABASE_USERNAME=root
DATABASE_PASSWORD=sapassword

# MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=docgo-files

# Server Configuration
HOST=0.0.0.0
PORT=8000
NODE_ENV=development

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_CLIENT_ID=file-storage-asset-service
