# DocGO Workspace .gitignore

###############################################################################
# ENVIRONMENT VARIABLES
###############################################################################

# Root-level environment files
.env
.env.local
.env.production
.env.staging
.env.*.local

# Track example env file as template
!.env.example

# Track env/ directories (contains .env.example)
!**/env/

# Environment files in all modules
**/.env
**/.env.local
**/.env.production
**/.env.staging

# Track example env files in all modules
!**/.env.example
!**/.env.template

# Ignore sensitive environment files inside env/ directories
**/env/.env
**/env/.env.local
**/env/.env.production
**/env/.env.staging

# Track example env file inside env/ directories
!**/env/.env.example

# Bỏ theo dõi .git-backup/env
.git-backup/env/

###############################################################################
# IDE / EDITOR FILES
###############################################################################

.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

###############################################################################
# OPERATING SYSTEM FILES
###############################################################################

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
desktop.ini
Desktop.ini
$RECYCLE.BIN/

###############################################################################
# TEMPORARY & BACKUP FILES
###############################################################################

*.tmp
*.temp
*.bak
*.backup
*.orig
*.rej
*.orig.*
*.rej.*
temp/
tmp/

###############################################################################
# LOG FILES
###############################################################################

*.log
logs/
*.out

###############################################################################
# DATABASE FILES
###############################################################################

*.db
*.sqlite
*.sqlite3

###############################################################################
# PYTHON
###############################################################################

__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# lib/ - Commented out to allow API Gateway lib/ directory
# lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
venv/
env/
ENV/
.venv/
# Exception: env/ directory in microservices should be tracked (contains .env.example)
!backend/*/env/

# Python service lib/ directories (ignore only in Python services)
backend/*/lib/
