# AI Processing Service - Development Environment

# Server Configuration
HOST=0.0.0.0
PORT=8000
NODE_ENV=development

# Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key-here

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLIENT_ID=ai-processing-service
KAFKA_GROUP_ID=ai-processing-group

# MongoDB Atlas Configuration
MONGODB_ATLAS_URI=mongodb+srv://root:sapassword@devgo-docgo-cluster0.hsudzga.mongodb.net/docgo_ai_service?retryWrites=true&w=majority&appName=devgo-docgo-cluster0

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Logging
LOG_LEVEL=INFO
