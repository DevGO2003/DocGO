# API Gateway BFF - Development Environment

# Server Configuration
NODE_ENV=development
PORT=8000
HOST=0.0.0.0

# Service URLs (only services present in this repo / docker-compose.local.yml)
API_GATEWAY_BFF_URL=http://localhost:8000
AUTHENTICATION_SERVICE_URL=http://authentication-identity-service:8000
CONTRACT_MANAGEMENT_SERVICE_URL=http://contract-management-service:8000
AI_PROCESSING_SERVICE_URL=http://ai-processing-service:8000
FILE_STORAGE_SERVICE_URL=http://file-storage-service:8000
USER_MANAGEMENT_SERVICE_URL=http://host.docker.internal:8002

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_CLIENT_ID=api-gateway-bff
KAFKA_GROUP_ID=api-gateway-group

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Elasticsearch Configuration
# (Elasticsearch not defined in local compose)

# JWT Configuration
JWT_SECRET=uzOtKeU86src9v9qrtctO09M07SI7RbM1xU3vi6nhr0=
JWT_EXPIRES_IN=24h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=logs/api-gateway.log

# Security
CORS_ORIGIN=http://localhost:3000
ENABLE_COMPRESSION=true
ENABLE_HELMET=true