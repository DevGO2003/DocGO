# API Gateway Configuration - Local Development
PORT=8000
NODE_ENV=development

# Service URLs for microservices in docker-compose.local.yml
# Internal communication uses service name and internal port (8000)
API_GATEWAY_BFF_URL=http://localhost:8000
AUTH_SERVICE_URL=http://authentication-identity-service:8000
CONTRACT_SERVICE_URL=http://contract-management-service:8000
AI_SERVICE_URL=http://ai-processing-service:8000
FILE_SERVICE_URL=http://file-storage-service:8000
CONTRACT_MANAGEMENT_SERVICE_URL=http://contract-management-service:8000
AI_PROCESSING_SERVICE_URL=http://ai-processing-service:8000
FILE_STORAGE_SERVICE_URL=http://file-storage-service:8000

# --- Other services not in the simplified docker-compose setup ---
USER_MANAGEMENT_SERVICE_URL=http://user-management-service:8002
VERSIONING_DOCUMENT_HISTORY_SERVICE_URL=http://versioning-document-history-service:8004
COMMENTING_COLLABORATION_SERVICE_URL=http://commenting-collaboration-service:8005
APPROVAL_WORKFLOW_SERVICE_URL=http://approval-workflow-service:8006
REMINDER_SCHEDULER_SERVICE_URL=http://reminder-scheduler-service:8007
ESIGNATURE_INTEGRATION_SERVICE_URL=http://esignature-integration-service:8008
NOTIFICATION_SERVICE_URL=http://notification-service:8009
REPORTING_ANALYTICS_SERVICE_URL=http://reporting-analytics-service:8010
OCR_DOCUMENT_EXTRACTION_SERVICE_URL=http://ocr-document-extraction-service:8011
AUDIT_ACTIVITY_LOG_SERVICE_URL=http://audit-activity-log-service:8013
INTEGRATION_CONNECTORS_SERVICE_URL=http://integration-connectors-service:8014
BATCH_ETL_SERVICE_URL=http://batch-etl-service:8015
HEALTH_MONITORING_AGENT_URL=http://health-monitoring-agent:8016
GENERAL_FILE_MANAGEMENT_SERVICE_URL=http://general-file-management-service:8018

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_CLIENT_ID=api-gateway-bff
KAFKA_GROUP_ID=api-gateway-group

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Elasticsearch Configuration
ELASTICSEARCH_URL=http://elasticsearch:9200

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=24h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=logs/api-gateway.log

# Security
CORS_ORIGIN=*
ENABLE_COMPRESSION=true
ENABLE_HELMET=true