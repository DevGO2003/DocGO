# Authentication Identity Service Configuration

# Application Configuration
APP_NAME=auth-service
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8001

# Database Configuration
DATABASE_URL=jdbc:mariadb://localhost:3306/docgo_auth_service
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=docgo_auth_service
DATABASE_USER=root
DATABASE_PASSWORD=sapassword
DATABASE_DRIVER=org.mariadb.jdbc.Driver

# JPA/Hibernate Configuration
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_DIALECT=org.hibernate.dialect.MariaDBDialect

# Security Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_EXPIRATION_TIME=86400000  # 24 hours in milliseconds
BCRYPT_STRENGTH=12

# Logging Configuration
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG

# Swagger Configuration
SWAGGER_UI_PATH=/docs
