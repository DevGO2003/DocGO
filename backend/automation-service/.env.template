# File Storage Asset Service - Development Environment Template

# Service Runtime Configuration
ENVIRONMENT=development

# MongoDB Atlas Configuration (REPLACE WITH YOUR VALUES)
MONGODB_ATLAS_URI=mongodb+srv://username:password@cluster.mongodb.net/docgo_file_service?retryWrites=true&w=majority&appName=your-cluster

# MinIO Configuration (REPLACE WITH YOUR VALUES)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET_NAME=your-bucket-name

# Server Configuration
HOST=0.0.0.0
PORT=8000
NODE_ENV=development

# Gemini AI Configuration (REPLACE WITH YOUR VALUES)
GEMINI_API_KEY=your-gemini-api-key-here

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLIENT_ID=automation-service
KAFKA_GROUP_ID=automation-group

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# S3 Configuration (Filebase) - REPLACE WITH YOUR VALUES
S3_ENABLED=true
S3_ENDPOINT=https://s3.filebase.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key
S3_BUCKET=your-bucket-name

# Local File Storage (Fallback/Local Dev)
UPLOAD_DIR=uploads
TEMP_DIR=temp
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=pdf,docx,txt,jpg,jpeg,png,gif

# Logging
LOG_LEVEL=INFO
