###############################################
# DocGO - Automation Service (.env.example)
###############################################

# --- App ---
APP_NAME=AI Processing Service
APP_VERSION=1.0.0
SERVICE_NAME=automation-service
HOST=0.0.0.0
PORT=8003
DEBUG=true

# --- AI Providers ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=automation-service
KAFKA_TOPIC_CONTRACTS=contracts
KAFKA_TOPIC_NOTIFICATIONS=notifications

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/ai_processing.log

# --- Limits/Paths ---
MAX_FILE_SIZE=10485760
RESULTS_DIR=./results
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=docx,pdf,txt

# --- Redis Cloud ---
REDIS_CLOUD_HOST=redis
REDIS_CLOUD_PORT=6379
REDIS_CLOUD_PASSWORD=
REDIS_DB=0

# --- S3 (tuỳ chọn) ---
S3_BUCKET=docgo-automation-files
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Base URL ---
BASE_URL=http://localhost:8003
