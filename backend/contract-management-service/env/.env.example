# Contract Management Service Configuration

# Application Configuration
APP_NAME=contract-service
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8002

# Database Configuration
DATABASE_URL=jdbc:mariadb://localhost:3306/docgo_contract_service
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=docgo_contract_service
DATABASE_USER=root
DATABASE_PASSWORD=sapassword
DATABASE_DRIVER=org.mariadb.jdbc.Driver

# JPA/Hibernate Configuration
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_DIALECT=org.hibernate.dialect.MariaDBDialect

# Logging Configuration
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG

# Swagger Configuration
SWAGGER_UI_PATH=/docs

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=pdf,docx,txt
