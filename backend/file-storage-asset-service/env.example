# Copy this file to .env and fill your secrets

# S3/Filebase configuration
S3_ENDPOINT=https://s3.filebase.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=REPLACE_WITH_YOUR_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_YOUR_SECRET
S3_BUCKET=devogo2003-docgo-bucket

# Optional: Filebase IPFS RPC
IPFS_RPC_ENDPOINT=https://rpc.filebase.io
# IPFS_RPC_TOKEN=REPLACE_WITH_YOUR_IPFS_TOKEN

