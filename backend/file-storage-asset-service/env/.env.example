# S3 / Filebase Configuration
S3_ENABLED=true
S3_PUBLIC_BUCKET=false
S3_ADDRESSING_STYLE=virtual
S3_KEY_STYLE=detailed
S3_METADATA_MINIMAL=false
S3_SANITIZE_KEYS=true
S3_ENDPOINT=https://s3.filebase.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_access_key_here
S3_SECRET_ACCESS_KEY=your_secret_key_here
S3_BUCKET=docgo-assets

# Optional IPFS (Filebase RPC) Configuration
IPFS_RPC_ENDPOINT=https://rpc.filebase.io
IPFS_RPC_TOKEN=your_ipfs_token_here

# ClamAV Configuration (Malware Scanner)
CLAMD_HOST=localhost
CLAMD_PORT=3310
USE_CLAMD=true

# File Storage Configuration
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=pdf,docx,txt,jpg,jpeg,png,gif
UPLOAD_DIR=uploads
TEMP_DIR=temp

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_FILE_EVENTS_TOPIC=file.events
KAFKA_AI_EVENTS_TOPIC=ai.events
KAFKA_CLIENT_ID=file-storage-asset-service