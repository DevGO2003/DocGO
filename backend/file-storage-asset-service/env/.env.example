# S3 / Filebase ConfigurationS3_ENABLED=trueS3_PUBLIC_BUCKET=falseS3_ADDRESSING_STYLE=virtualS3_KEY_STYLE=detailedS3_METADATA_MINIMAL=falseS3_SANITIZE_KEYS=trueS3_ENDPOINT=https://s3.filebase.comS3_REGION=us-east-1S3_ACCESS_KEY_ID=your_access_key_hereS3_SECRET_ACCESS_KEY=your_secret_key_hereS3_BUCKET=docgo-assets# Optional IPFS (Filebase RPC) ConfigurationIPFS_RPC_ENDPOINT=https://rpc.filebase.ioIPFS_RPC_TOKEN=your_ipfs_token_here# ClamAV Configuration (Malware Scanner)CLAMD_HOST=localhostCLAMD_PORT=3310USE_CLAMD=true# File Storage ConfigurationMAX_FILE_SIZE=104857600ALLOWED_FILE_TYPES=pdf,docx,txt,jpg,jpeg,png,gifUPLOAD_DIR=uploadsTEMP_DIR=temp# KafkaKAFKA_BOOTSTRAP_SERVERS=localhost:9092KAFKA_FILE_EVENTS_TOPIC=file.eventsKAFKA_AI_EVENTS_TOPIC=ai.eventsKAFKA_CLIENT_ID=file-storage-asset-service