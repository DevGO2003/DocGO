# File Storage Service Environment - Local Development

# Service Runtime Configuration
ENVIRONMENT=development

# MongoDB Atlas Configuration
MONGODB_ATLAS_URI=mongodb+srv://root:sapassword@devgo-docgo-cluster0.hsudzga.mongodb.net/docgo_file_service?retryWrites=true&w=majority&appName=devgo-docgo-cluster0

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_CLIENT_ID=file-storage-asset-service
KAFKA_FILE_UPLOADED_TOPIC=file.uploaded

# S3 Configuration (Filebase)
S3_ENABLED=true
S3_ENDPOINT=https://s3.filebase.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=D6D49B01A4B01DE0EA12
S3_SECRET_ACCESS_KEY=z9oNlDnVcW7eoVkLNquYzKFfv7Ca5vSz146KXeMX
S3_BUCKET=devgo2003-docgo-bucket

# Local File Storage (Fallback/Local Dev)
UPLOAD_DIR=uploads
TEMP_DIR=temp
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=pdf,docx,txt,jpg,jpeg,png,gif