# User Management Service - Development Environment Template

# JWT Configuration (REPLACE WITH YOUR VALUES)
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth2 Configuration (REPLACE WITH YOUR VALUES)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8001/login/oauth2/code/google
GOOGLE_CLIENT_EMAIL=your-service-email@gmail.com
GOOGLE_PROJECT_ID=your-project-id

# Server Configuration
SERVER_PORT=8001
SERVER_HOST=0.0.0.0

# Redis Configuration (for token blacklist)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Logging
LOG_LEVEL=INFO

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
