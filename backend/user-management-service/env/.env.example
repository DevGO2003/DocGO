# ==============================================
# DocGO - User Management Service (.env.example)
# ==============================================

# --- Application ---
SERVER_PORT=8001

# --- MongoDB Atlas ---
MONGODB_ATLAS_URI=mongodb+srv://<user>:<pass>@devgo-docgo-cluster0.hsudzga.mongodb.net
MONGODB_DATABASE=docgo_user

# --- Redis Cloud (tuỳ chọn) ---
REDIS_CLOUD_HOST=redis
REDIS_CLOUD_PORT=6379
REDIS_CLOUD_PASSWORD=
REDIS_DB=0

# --- JWT ---
JWT_SECRET=<generate-strong-base64-secret>

# --- OAuth2 (Google - tuỳ chọn) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Swagger ---
SWAGGER_ENABLED=true
DATABASE_HOST=localhost
DATABASE_NAME=docgo_auth_service
DATABASE_PASSWORD=your-database-password
DATABASE_PORT=3306
DATABASE_URL=jdbc:mysql://localhost:3306/docgo_auth_service
DATABASE_USERNAME=root
GOOGLE_CLIENT_EMAIL=your-email@gmail.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_PROJECT_ID=docgoauthen
GOOGLE_REDIRECT_URI=http://localhost:8001/login/oauth2/code/google
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production
LOG_LEVEL=INFO
REDIS_DATABASE=0
REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_PORT=6379
SERVER_HOST=0.0.0.0
SERVER_PORT=8001
