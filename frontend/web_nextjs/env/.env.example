# DocGO Frontend Environment Variables
# Copy this file to .env.local and update the values

# Enable Google OAuth
NEXT_PUBLIC_ENABLE_GOOGLE_OAUTH=true

# API Gateway BFF URL
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8000

# Authentication Service URL
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:8001

# Contract Management Service URL
NEXT_PUBLIC_CONTRACT_SERVICE_URL=http://localhost:8003

# AI Processing Service URL
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8017

# File Storage Service URL
NEXT_PUBLIC_FILE_SERVICE_URL=http://localhost:8012

# Application Environment
NODE_ENV=development