{
  "name": "github-mcp-server",
  "description": "GitHub Model Context Protocol Server for DocGO",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/lib.d.ts",
        "default": "./dist/esm/lib.js"
      },
      "require": {
        "types": "./dist/cjs/lib.d.ts",
        "default": "./dist/cjs/lib.js"
      }
    }
  },
  "main": "./dist/cjs/lib.js",
  "types": "./dist/cjs/lib.d.ts",
  "author": "DocGO Team",
  "homepage": "https://github.com/DevGO2003/DocGO",
  "repository": {
    "url": "https://github.com/DevGO2003/DocGO.git"
  },
  "bin": {
    "github-mcp-server": "dist/esm/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/index.js --transport http --loggers stderr mcp",
    "start:stdio": "node dist/index.js --transport stdio --loggers stderr mcp",
    "prepare": "npm run build",
    "build:clean": "if exist dist rmdir /s /q dist",
    "build:esm": "tsc --project tsconfig.esm.json",
    "build:cjs": "tsc --project tsconfig.cjs.json",
    "build:chmod": "echo chmod skipped on Windows",
    "build": "npm run build:clean && npm run build:esm && npm run build:cjs && npm run build:chmod",
    "inspect": "npm run build && mcp-inspector -- dist/esm/index.js",
    "prettier": "prettier",
    "check": "npm run build && npm run check:types && npm run check:lint && npm run check:format",
    "check:lint": "eslint .",
    "check:format": "prettier -c .",
    "check:types": "tsc --noEmit --project tsconfig.json",
    "fix": "npm run fix:lint && npm run reformat",
    "fix:lint": "eslint . --fix",
    "reformat": "prettier --write .",
    "test": "vitest --coverage"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "@types/yargs-parser": "^21.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.4",
    "@octokit/rest": "^20.0.2",
    "@octokit/auth-app": "^6.0.1",
    "@octokit/auth-token": "^5.0.1",
    "lru-cache": "^11.1.0",
    "yargs-parser": "^21.1.1",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >= 23.0.0"
  }
}
